# /etc/fox/fox.env: fox's settings on a server (world-readable: no secrets here; those go in /etc/fox/secrets.env).
# The address you open fox at. fox only accepts requests for exactly this host.
FOX_PUBLIC_ORIGIN=https://fox.example.com
PORT=4848
TMUX_TMPDIR=/home/fox/.tmux
# Jobs run in their own service (fox-jobs), so a deploy never cuts one.
FOX_JOBS_RUNNER=external
# Sessions waiting for you, with nobody looking, sleep after this many minutes (each holds 300-500 MB with tools).
FOX_IDLE_SLEEP_MIN=30
# Optional: time zone for jobs.
# FOX_DEFAULT_TZ=Europe/Berlin
# Optional: open the dev servers fx starts through their own hostnames (one per port, each behind Cloudflare Access).
# FOX_PREVIEW_URL=https://fox-{port}.example.com
# FOX_PREVIEW_PORTS=3000,5173,8080
# Optional: named apps, https://<name>.example.com (a wildcard DNS record and tunnel rule to FOX_APPS_PORT).
# FOX_APPS_URL=https://{name}.example.com
# FOX_APPS_PORT=4850
