#!/usr/bin/env bash
# git credential helper: picks the GitHub token by the repo's owner, so one server can hold one fine-grained
# token per owner (a user or an org). Tokens live in ~/.config/fox-git/tokens/<owner> (saved by fox-git-token);
# without one for that owner, gh's own login answers.
# git config --global credential.https://github.com.helper '!fox-git-credential'
# git config --global credential.https://github.com.useHttpPath true
[ "$1" = get ] || exit 0
host="" path=""
while IFS='=' read -r k v; do
  [ -z "$k" ] && break
  case "$k" in host) host="$v" ;; path) path="$v" ;; esac
done
[ "$host" = github.com ] || exit 0
owner="$(printf %s "${path%%/*}" | tr A-Z a-z)"
file="$HOME/.config/fox-git/tokens/$owner"
if [ -n "$owner" ] && [ -f "$file" ]; then
  echo "username=x-access-token"
  echo "password=$(cat "$file")"
else
  printf 'protocol=https\nhost=github.com\n\n' | /usr/bin/gh auth git-credential get
fi
