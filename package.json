{
  "name": "fox",
  "version": "0.1.0",
  "description": "Your fx coding agents on your own server, from any device: sessions, subagents, tmux-backed terminals, jobs",
  "license": "MIT",
  "author": "Javier Wasserman",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamarks/fox"
  },
  "homepage": "https://github.com/jamarks/fox",
  "keywords": [
    "fx",
    "coding-agent",
    "tmux",
    "xterm",
    "vercel"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "fox": "./bin/fox.mjs",
    "fox-job": "./bin/fox-job.mjs"
  },
  "scripts": {
    "start": "node server.mjs",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "test": "node --test 'tests/**/*.test.mjs'"
  },
  "dependencies": {
    "@fontsource/source-code-pro": "^5.3.1",
    "@highlightjs/cdn-assets": "^11.12.0",
    "@simplewebauthn/server": "^13.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "marked": "^18.1.1",
    "node-pty": "^1.1.0",
    "qrcode": "^1.5.4",
    "ws": "^8.22.0"
  }
}
