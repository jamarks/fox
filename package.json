{
  "name": "fox",
  "version": "0.1.0",
  "description": "Local web panel for the fx coding agent: sessions, tmux-backed terminals, live states and transcripts",
  "license": "MIT",
  "author": "Javier Wasserman",
  "repository": {
    "type": "git",
    "url": "https://github.com/jamarks/fox"
  },
  "homepage": "https://github.com/jamarks/fox",
  "keywords": [
    "fx",
    "coding-agent",
    "tmux",
    "xterm",
    "vercel"
  ],
  "engines": {
    "node": ">=20"
  },
